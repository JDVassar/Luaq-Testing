__LQ_CAPTURE.Complete=function()
 local root=__LQ_CAPTURE.applicationRoot
 if not root or __LQ_CAPTURE.completionDone or __LQ_CAPTURE.completionBusy then return end
 __LQ_CAPTURE.completionBusy=true
 local queue,seen={root},{[root]=true}
 local processed,decoded,failures=0,0,0
 local function enqueue(proto)if proto and not seen[proto]then seen[proto]=true;queue[#queue+1]=proto end end
 while processed<#queue do
  processed+=1
  local proto=queue[processed]
  for _,child in pairs(proto.K)do enqueue(child)end
  if proto.t>0 then
   local ok,message=pcall(tFetch,proto,1,B(proto.m,0))
   if not ok then failures+=1;__LQ_CAPTURE.emit('completion_probe_error',proto.m,1,'entry_page',tostring(message))end
  end
  for pc=1,proto.t do
   if proto.X[pc]or proto.k[pc]then
    local ok,message=pcall(function()
     local packet=tFetch(proto,pc,B(proto.m,0))
     local info=__completionInfo[packet[1]]
     if not info then return end
     local read,finish=__completionDecode(packet,proto,pc,info.params[1],info.params[2],info.params[3])
     for index=2,#packet-2 do read()end
     local permutation,nextState=finish()
     local F,I,c,D,V,m,t=proto,{[0]={}},pc+1,packet,0,packet[1],0
     local bank=info.bank
     if bank=='C'then __completionVM:C(m,V,I,c,D,__completionDecode,__completionLanes,E[10],z,F,t)
     elseif bank=='v'then __completionVM:v(V,D,t,E[10],c,__completionDecode,z,m,F,I,__completionLanes)
     elseif bank=='D'then __completionVM:D(m,c,V,D,E[10],__completionDecode,z,I,F,t,__completionLanes)
     elseif bank=='y'then __completionVM:y(F,E[10],t,D,c,V,m,__completionDecode,z,I,__completionLanes)
     elseif bank=='O'then __completionVM:O(__completionLanes,c,D,__completionDecode,z,m,t,F,V,I,E[10])
     elseif bank=='w'then __completionVM:w(I,m,V,F,__completionDecode,t,E[10],D,c,__completionLanes,z) end
     decoded+=1
     for _,slot in ipairs(info.constants)do
      local index=I[slot]
      if type(index)=='number'and index>=1 and index<=proto.j then
       local success,value=pcall(P,proto,index,nextState)
       if not success then failures+=1;__LQ_CAPTURE.emit('completion_probe_error',proto.m,index,'constant',tostring(value))end
      end
     end
     for _,slot in ipairs(info.children)do
      local index=I[slot]
      if type(index)=='number'and(proto.F[index]or proto.K[index])then
       local success,child=pcall(U,proto,index,nextState)
       if success then enqueue(child)else failures+=1;__LQ_CAPTURE.emit('completion_probe_error',proto.m,index,'child',tostring(child))end
      end
     end
    end)
    if not ok then __LQ_CAPTURE.emit('completion_packet_skipped',proto.m,pc,'',tostring(message))end
   end
  end
 end
 __LQ_CAPTURE.emit('completion_status',root.m,processed,'decoded_packets',tostring(decoded)..'; read failures='..tostring(failures))
 __LQ_CAPTURE.completionBusy=false
 __LQ_CAPTURE.completionDone=true
